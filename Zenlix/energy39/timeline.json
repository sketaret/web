      "name": "رنّة من غير رد",
      "draftVoice": "كل رنّة من غير رد… ممكن تكون أوردر ضايع."
    },
    {
      "id": 2,
      "start": 7,
      "end": 10,
      "kind": "competitor",
      "name": "عميلك ممكن يختار غيرك",
      "draftVoice": "وعميلك ممكن يختار غيرك."
    },
    {
      "id": 3,
