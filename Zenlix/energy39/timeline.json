      "end": 16,
      "kind": "follow-up",
      "name": "تابع الفرصة",
      "draftVoice": "مع زِنليكس سوليوشنز، تابع المكالمات الفائتة، وارجع لعميلك."
    },
    {
      "id": 4,
      "start": 16,
      "end": 22,
      "kind": "team",
      "name": "قيّم ودرّب فريقك",
      "draftVoice": "اعرف أداء فريقك، قيّم الجودة، ودرّب اللي محتاج يتطوّر."
    },
    {
      "id": 5,
      "start": 22,
      "end": 31,
      "kind": "crm",
      "name": "فاكرين تفاصيله",
      "draftVoice": "ولو عميل اشتكى قبل كده، افتح ملفه وراجع الشكوى… عشان يحس إنك فاكره، من غير ما يعيد الحكاية."
    },
    {
      "id": 6,
      "start": 31,
      "end": 37,
      "kind": "benefits",
      "name": "فرصك وفريقك وعميلك",
      "draftVoice": "متابعة فرصك. فريق أقوى. اهتمام بكل عميل."
    },
    {
      "id": 7,
      "start": 37,
      "end": 39,
      "kind": "closing",
      "name": "كل مكالمة ليها قيمة",
      "draftVoice": "كل مكالمة ليها قيمة."
